<?xml version="1.0" encoding="utf-8"?>
<!--
  25仔 的 MSIX 清单模板（全信任 Win32）。
  提交前由 .github/workflows/store.yml 把下面四个占位符替换掉：
    {{IDENTITY_NAME}}          Partner Center 里的“包名称”，如 2169HaleWang.25zai
    {{PUBLISHER}}              Partner Center 里的 Publisher，如 CN=0D4B9868-...
    {{PUBLISHER_DISPLAY_NAME}} 显示名，如 refout
    {{VERSION}}                四段版本号，如 0.1.2.0

  全信任应用（runFullTrust）能保留现有的多进程守护 + 回环 TCP + 全局热键 + 托盘。
  开机自启不用 HKCU\Run（MSIX 里会被虚拟化），改走 desktop:StartupTask，
  运行时由 erwuzai-platform 的 autostart 调 WinRT StartupTask 开关。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>25仔</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application
      Id="App"
      Executable="25zai.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="25仔"
        Description="本地剪贴板历史管理器"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension
          Category="windows.startupTask"
          Executable="25zai.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="25zaiDaemon" Enabled="false" DisplayName="25仔" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
